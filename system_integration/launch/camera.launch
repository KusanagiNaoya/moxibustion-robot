<?xml version="1.0"?>
<launch>
  <arg name="camera" default="camera"/>
  <arg name="serial_no" default=""/>
  <arg name="resolution_mode" default="720p"/>
  <arg name="filters" default="decimation, disparity, spatial, temporal, hole_filling"/>
  <!-- 光学坐标系由 B_T_C 单独连接到基座，驱动不重复发布相机 TF。 -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="$(arg camera)"/>
    <arg name="tf_prefix" value="$(arg camera)"/>
    <arg name="serial_no" value="$(arg serial_no)"/>
    <arg name="color_width" value="$(eval 1280 if arg('resolution_mode') == '720p' else 640)"/>
    <arg name="color_height" value="$(eval 720 if arg('resolution_mode') == '720p' else 480)"/>
    <arg name="depth_width" value="$(eval 1280 if arg('resolution_mode') == '720p' else 640)"/>
    <arg name="depth_height" value="$(eval 720 if arg('resolution_mode') == '720p' else 480)"/>
    <arg name="infra_width" value="$(eval 1280 if arg('resolution_mode') == '720p' else 640)"/>
    <arg name="infra_height" value="$(eval 720 if arg('resolution_mode') == '720p' else 480)"/>
    <arg name="color_fps" value="30"/>
    <arg name="depth_fps" value="30"/>
    <arg name="infra_fps" value="30"/>
    <arg name="enable_color" value="true"/>
    <arg name="enable_depth" value="true"/>
    <arg name="enable_infra1" value="true"/>
    <arg name="enable_infra2" value="true"/>
    <arg name="enable_sync" value="true"/>
    <arg name="align_depth" value="true"/>
    <arg name="enable_pointcloud" value="false"/>
    <arg name="enable_gyro" value="false"/>
    <arg name="enable_accel" value="false"/>
    <arg name="publish_tf" value="false"/>
    <arg name="publish_odom_tf" value="false"/>
    <arg name="filters" value="$(arg filters)"/>
  </include>
</launch>
