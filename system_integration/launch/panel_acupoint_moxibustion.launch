<?xml version="1.0"?>
<launch>
  <arg name="task_config" default="$(find moxibustion_api)/config/control.yaml"/>
  <arg name="gui_config" default="$(find system_integration)/config/gui.yaml"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="camera_frame" default="camera_color_optical_frame"/>
  <arg name="robot_interface_ns" default="/moxa_robot"/>
  <arg name="action_name" default="/moxibustion_task"/>
  <arg name="sensor_topic" default="/moxibustion_api/sensor/sample"/>
  <arg name="color_topic" default="/camera/color/image_raw"/>
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/color/camera_info"/>
  <arg name="detect_service" default="/acupoint_detection_server/detect_acupoints"/>
  <arg name="ready_service" default="/acupoint_detection_server/ready"/>
  <arg name="enable_home" default="false"/>
  <arg name="enable_gripper" default="false"/>
  <node pkg="system_integration" type="panel_acupoint_moxibustion.py" name="moxibustion_panel" output="screen">
    <rosparam command="load" file="$(arg gui_config)"/>
    <rosparam command="load" file="$(arg task_config)" ns="task"/>
    <param name="task/base_frame" value="$(arg base_frame)"/>
    <param name="task/robot_interface_ns" value="$(arg robot_interface_ns)"/>
    <param name="task/action_name" value="$(arg action_name)"/>
    <param name="task/sensor_topic" value="$(arg sensor_topic)"/>
    <param name="camera_frame" value="$(arg camera_frame)"/>
    <param name="color_topic" value="$(arg color_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="detect_service" value="$(arg detect_service)"/>
    <param name="ready_service" value="$(arg ready_service)"/>
    <param name="enable_home" value="$(arg enable_home)"/>
    <param name="enable_gripper" value="$(arg enable_gripper)"/>
  </node>
</launch>
